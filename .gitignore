# ═══════════════════════════════════════════════════════════════
#  Retro+ Box × 三和摇杆 改装套件  ·  .gitignore
#
#  ⚠️ 本仓库的图纸文件（*.step / *.pdf / *.dxf / *.png / *.jpg）
#     就是项目本体，全部需要提交。
#     添加新规则时请勿误伤 sanwa_mod/ 与 docs/images/ 下的文件。
#     当前仓库全部文件合计约 3.6 MB，远低于 GitHub 单文件 100 MB 上限，
#     暂不需要 Git LFS。
# ═══════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────
#  操作系统生成的文件
# ───────────────────────────────────────────────────────────────

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux / 通用
*~


# ───────────────────────────────────────────────────────────────
#  编辑器与 IDE
# ───────────────────────────────────────────────────────────────

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
.project
.classpath
.settings/


# ───────────────────────────────────────────────────────────────
#  临时文件、草稿与渲染中间产物
# ───────────────────────────────────────────────────────────────

# 图纸反解 / 预览渲染用的临时目录（用完即删）
_render/
_tmp/
tmp/
temp/

*.tmp
*.temp
*.bak
*.orig
*.rej
*.old
*.draft


# ───────────────────────────────────────────────────────────────
#  CAD / 设计软件产生的备份与锁文件
# ───────────────────────────────────────────────────────────────

~$*
*.lck
*.dwl
*.dwl2
*.f3d.bak
*.sldprt.bak
*.sldasm.bak
Backup/
backups/


# ───────────────────────────────────────────────────────────────
#  Python（后续若添加尺寸解析 / 预览生成脚本）
# ───────────────────────────────────────────────────────────────

__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/


# ───────────────────────────────────────────────────────────────
#  Node（后续若添加文档站 / 工具链）
# ───────────────────────────────────────────────────────────────

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
dist/
.nuxt/
.cache/
.parcel-cache/


# ───────────────────────────────────────────────────────────────
#  本仓库专属
# ───────────────────────────────────────────────────────────────

# 本机 AI 助手的工作数据（会话记忆等），属于个人环境，不对外发布。
# 若希望协作者也能看到这些笔记，删掉下面这行即可。
.workbuddy/

# 加工报价单、采购/订单记录等不宜公开的商务文件
报价*
订单*
采购*
*.quote
*.price


# ───────────────────────────────────────────────────────────────
#  大文件兜底
# ───────────────────────────────────────────────────────────────
# GitHub 单文件上限 100 MB，超过 50 MB 会给出警告。
# 若将来要提交超大 3D 扫描件 / 高精度网格，请改用 Git LFS：
#   git lfs track "*.stl"
# 当前仓库无需 LFS。
